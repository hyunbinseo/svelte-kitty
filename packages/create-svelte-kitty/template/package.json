{
	"name": "svelte-kitty-starter",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"start": "node build/start",
		"start:pm2": "pm2 start pm2.config.cjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:cli": "svelte-kit sync && tsc --project ./db/tsconfig.check.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:prod": "drizzle-kit migrate --config=drizzle.production.ts",
		"db:studio": "drizzle-kit studio",
		"db:studio:prod": "drizzle-kit studio --config=drizzle.production.ts"
	},
	"dependencies": {
		"@hyunbinseo/tools": "^0.3.9",
		"better-sqlite3": "^12.11.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"new-request": "^0.0.40",
		"ulid": "^3.0.2",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24.13.3",
		"autoprefixer": "^10.5.4",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jose": "^6.2.8",
		"pm2-ecosystem": "^7.0.3",
		"postcss": "^8.5.25",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"svelte-form-enhanced": "^0.2.1",
		"svelte-html-modal": "^3.2.0",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^7.3.5"
	},
	"engines": {
		"node": ">=24.11"
	}
}
